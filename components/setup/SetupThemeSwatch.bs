import "pkg:/components/setup/setupPreviewDraw.bs"
import "pkg:/source/utils/playbackOverlay.bs"
import "pkg:/source/utils/themeRegistry.bs"

' One pickable theme, shown as its own surface and background with the
' accent sitting on top. Drawn at its final 300x230 size.
sub init()
    m.built = false
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while
    m.built = false

    theme = themeRegistry.ReadBundledTheme(m.top.themeId)
    if not isValid(theme) or not isValid(theme.colors) then return

    palette = setupPreviewDraw.Palette()
    surface = formatSceneGraphColor(theme.colors.surface, "0x101010FF")
    background = formatSceneGraphColor(theme.colors.background, "0x000018FF")
    accent = formatSceneGraphColor(theme.colors.accent, "0xFF6867FF")
    onSurface = formatSceneGraphColor(theme.colors.onSurface, "0xFFFFFFFF")

    m.ring = setupPreviewDraw.Rect(m.top, 0, 0, 300, 190, palette.onSurfaceFaint)
    setupPreviewDraw.Rect(m.top, 4, 4, 292, 91, surface)
    setupPreviewDraw.Rect(m.top, 4, 95, 292, 91, background)
    setupPreviewDraw.Rect(m.top, 28, 76, 38, 38, accent)
    setupPreviewDraw.Rect(m.top, 90, 88, 160, 14, playbackOverlay.WithAlpha(onSurface, 180))

    m.nameLabel = m.top.createChild("Label")
    m.nameLabel.translation = [0, 200]
    m.nameLabel.width = 300
    m.nameLabel.horizAlign = "center"
    m.nameLabel.font = "font:SmallSystemFont"
    m.nameLabel.text = m.top.themeName

    m.built = true
    updateState()
end sub

sub updateState()
    if not m.built then return
    palette = setupPreviewDraw.Palette()
    if m.top.focused
        m.ring.color = palette.onSurface
    else if m.top.selected
        m.ring.color = palette.onSurfaceDim
    else
        m.ring.color = palette.onSurfaceFaint
    end if
    m.nameLabel.color = (m.top.selected or m.top.focused) ? palette.onSurface : palette.onSurfaceDim
end sub
