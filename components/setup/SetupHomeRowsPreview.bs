import "pkg:/components/setup/setupPreviewDraw.bs"

' Miniature home rows in the two styles. Modern's whole point is the focused
' card, so its preview holds the first card in that state with the text block
' it grows underneath. Classic's point is density, three tight rows.
sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    pal = setupPreviewDraw.Palette()
    items = m.top.items
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)

    if m.top.modern
        ' The focused cell grows into a landscape thumbnail with its text block
        ' underneath, the way the real modern rows slide open on focus
        setupPreviewDraw.Rect(m.top, 110, 150, 340, 36, pal.onSurfaceDim)
        first = setupPreviewDraw.ItemField(items, 0, "backdropUrl")
        setupPreviewDraw.Rect(m.top, 102, 217, 481, 286, pal.onSurface)
        setupPreviewDraw.Art(m.top, 110, 225, 465, 270, first, pal.surfaceVariant)
        setupPreviewDraw.Rect(m.top, 110, 525, 260, 34, pal.onSurface)
        setupPreviewDraw.Rect(m.top, 110, 572, 200, 24, pal.onSurfaceDim)
        for i = 1 to 6
            x = 615 + (i - 1) * 200
            uri = setupPreviewDraw.ItemField(items, i, "posterUrl")
            setupPreviewDraw.Art(m.top, x, 225, 180, 270, uri, pal.surfaceVariant)
            setupPreviewDraw.Rect(m.top, x, 511, 140, 22, pal.onSurfaceDim)
        end for
        setupPreviewDraw.Rect(m.top, 110, 680, 300, 34, pal.onSurfaceDim)
        setupPreviewDraw.PosterRow(m.top, items, 110, 740, 180, 270, 20, 9, pal, 3)
        setupPreviewDraw.Rect(m.top, 110, 1035, 280, 30, pal.onSurfaceDim)
    else
        for row = 0 to 2
            setupPreviewDraw.Rect(m.top, 60, 40 + row * 350, 300, 30, pal.onSurfaceDim)
            setupPreviewDraw.PosterRow(m.top, items, 60, 88 + row * 350, 160, 240, 26, 10, pal, row * 2)
        end for
    end if
end sub
